# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://username:password@host:port/database_name?options

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Security Configurations
# Merchant Session Tokens
JWT_MERCHANT_ACCESS_SECRET=your_merchant_access_secret_hash
JWT_MERCHANT_ACCESS_EXPIRATION=45m
JWT_MERCHANT_REFRESH_SECRET=your_merchant_refresh_secret_hash
JWT_MERCHANT_REFRESH_EXPIRATION=7d

# User/Customer Session Tokens
JWT_USER_ACCESS_SECRET=your_user_access_secret_hash
JWT_USER_ACCESS_EXPIRATION=45m
JWT_USER_REFRESH_SECRET=your_user_refresh_secret_hash
JWT_USER_REFRESH_EXPIRATION=7d

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
GENERAL_RATE_LIMIT_MAX=300

# File Upload Configuration
UPLOAD_PATH=uploads/
